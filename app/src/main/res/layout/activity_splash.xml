<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/splash_image_logo"
        android:layout_width="168dp"
        android:layout_height="139dp"
        android:contentDescription="@string/logo"
        app:layout_constraintBottom_toTopOf="@+id/splash_image_loading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/apparel_24px" />

    <ImageView
        android:id="@+id/splash_image_loading"
        android:layout_width="147dp"
        android:layout_height="147dp"
        android:layout_marginTop="32dp"
        android:contentDescription="@string/icono_cargando"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splash_image_logo"
        app:srcCompat="@drawable/incomplete_circle_24px" />

</androidx.constraintlayout.widget.ConstraintLayout>
